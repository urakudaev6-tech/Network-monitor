# Скопируй в .env для локального запуска (не в Docker).
# DATABASE_URL=sqlite:///./network_monitor.db

# Для PostgreSQL через Docker:
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=network_monitor

# Интервал автоматических проверок (секунды). 0 = выключен.
SCHEDULER_INTERVAL=60

# CORS: через запятую
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Только для запуска backend ВНЕ Docker (Docker подставит свой URL):
# DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/network_monitor